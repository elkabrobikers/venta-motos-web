
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String
  precio      Float
  categoria   String

  // Información adicional del producto
  marca       String  @default("")
  modelo      String  @default("")
  descripcion String  @default("")
  imagenUrl   String  @default("")
  stock       Int     @default(0)

  // Fotografía almacenada directamente en PostgreSQL
  imagen      Bytes?
  imagenTipo  String  @default("")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  correo       String   @unique
  passwordHash String
  rol          String   @default("cliente")
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())
}
